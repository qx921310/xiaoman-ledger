{
  "name": "xiaoman-ledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "node server/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:balances && npm run test:sync-identities",
    "check": "npm run typecheck && npm test && npm run icons:check && npm run ui:tokens && npm run ui:contrast && npm run lint && npm run build",
    "icons": "node scripts/icon-manifest.mjs --write",
    "icons:check": "node scripts/icon-manifest.mjs",
    "ui:tokens": "node scripts/ui-tokens.mjs",
    "ui:contrast": "node scripts/ui-contrast.mjs",
    "test:balances": "node tests/run-balances.cjs",
    "test:sync-identities": "node --test tests/sync-identities.test.mjs",
    "lint": "eslint src"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "description": "小满记账 · 个人记账 Web 应用（React + SQLite，本地优先）",
  "engines": {
    "node": ">=22.5"
  }
}