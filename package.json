{
  "name": "xiaoman-ledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "node server/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:balances && npm run test:sync-identities && npm run test:account-session && npm run test:statistics && npm run test:privacy-ocr && npm run test:category-order && npm run test:multidevice && npm run test:concurrency && npm run test:auto-sync && npm run test:offline && npm run test:multi-tab && npm run test:no-self-loop && npm run test:session-epoch && npm run test:sync-v2 && npm run test:cr-v2",
    "check": "npm run typecheck && npm test && npm run icons:check && npm run ui:tokens && npm run ui:contrast && npm run lint && npm run build && npm run test:fixes",
    "icons": "node scripts/icon-manifest.mjs --write",
    "icons:check": "node scripts/icon-manifest.mjs",
    "ui:tokens": "node scripts/ui-tokens.mjs",
    "ui:contrast": "node scripts/ui-contrast.mjs",
    "test:account-session": "node --test tests/account-session.test.mjs",
    "test:statistics": "node --test tests/statistics-charts.test.mjs",
    "test:privacy-ocr": "node --test tests/server-privacy.test.mjs tests/ocr-confirm.test.mjs",
    "test:balances": "node tests/run-balances.cjs",
    "test:sync-identities": "node --test tests/sync-identities.test.mjs",
    "lint": "eslint src",
    "hooks:install": "node scripts/install-hooks.mjs",
    "guard": "node scripts/guard-staged.mjs",
    "audit:migration": "node scripts/audit-migration.mjs",
    "test:category-order": "node --test tests/category-order.test.mjs",
    "test:multidevice": "node --test tests/sync-multidevice.test.mjs",
    "test:concurrency": "node --test tests/sync-concurrency.test.mjs",
    "test:auto-sync": "node tests/run-auto-sync.cjs",
    "test:offline": "node tests/run-offline-auth.cjs",
    "test:multi-tab": "node tests/run-multi-tab.cjs",
    "test:no-self-loop": "node tests/run-no-self-loop.cjs",
    "test:session-epoch": "node tests/run-session-epoch.cjs",
    "test:sync-v2": "node --test tests/sync-v2-server.test.mjs tests/sync-v2-state.test.mjs tests/sync-v2-runner.test.mjs tests/sync-v2-integration.test.mjs",
    "test:cr-v2": "node tests/run-cr-sync-v2.cjs",
    "test:fixes": "node tests/run-fix-regressions.cjs"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "lunar-typescript": "^1.8.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "description": "小满记账 · 个人记账 Web 应用（React + SQLite，本地优先）",
  "engines": {
    "node": ">=22.5"
  }
}
